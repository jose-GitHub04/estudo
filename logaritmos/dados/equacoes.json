      {"tex": "e^{x}=\\frac{6}{e-1}\\Leftrightarrow x=\\ln\\left(\\frac{6}{e-1}\\right)"}
     ]
    },
    {
     "titulo": "Valor aproximado",
     "fase": "resolver",
     "texto": "A calculadora só entra no fim. Guarda o valor exato e arredonda apenas o resultado.",
     "linhas": [
      {"tex": "\\ln\\left(\\frac{6}{e-1}\\right)=\\ln 6-\\ln(e-1)\\approx1{,}25"}
     ]
    },
    {
     "titulo": "Verificar",
     "fase": "verificar",
     "texto": "Substitui $e^x$ por $\\frac{6}{e-1}$ na forma fatorizada. O domínio é $\\mathbb{R}$, por isso a solução serve.",
     "linhas": [
      {"tex": "e^{\\ln\\left(\\frac{6}{e-1}\\right)}(e-1)=\\frac{6}{e-1}(e-1)=6"}
     ]
    }
   ],
   "resposta": "S=\\left\\{\\ln\\left(\\frac{6}{e-1}\\right)\\right\\}\\approx\\{1{,}25\\}"
